{
  "name": "espocrm-ext-lucid-theme",
  "version": "0.12.2",
  "description": "Lucid: a light, readable and accessible theme for EspoCRM",
  "scripts": {
    "watch": "node scripts/watch.js",
    "copy": "node build --copy",
    "composer-install": "node build --composer-install",
    "sync": "node build --copy",
    "extension": "node build --extension",
    "clear-cache": "docker compose -f ../compose.yaml exec -T web php clear_cache.php",
    "rebuild": "node build --rebuild",
    "all": "node build --all"
  },
  "type": "module",
  "author": "Alexis SANTIN",
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "espo-extension-tools": "github:espocrm/extension-tools#0.4.5",
    "fs-extra": "^9.0.0"
  },
  "engines": {
    "npm": ">=8",
    "node": ">=18"
  }
}

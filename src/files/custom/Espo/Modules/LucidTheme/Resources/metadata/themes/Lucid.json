{
    "stylesheet": "client/custom/modules/lucid-theme/css/lucid.css",
    "stylesheetIframe": "client/custom/modules/lucid-theme/css/lucid-iframe.css",
    "logo": "client/img/logo-light.svg",
    "params": {
        "navbar": {
            "type": "enum",
            "default": "side",
            "options": ["side", "top"]
        }
    },
    "mappedParams": {
        "navbarHeight": {
            "param": "navbar",
            "valueMap": {
                "side": 48,
                "top": 43
            }
        }
    },
    "dashboardCellHeight": 40,
    "dashboardCellMargin": 16,
    "navbarHeight": 43,
    "modalFooterAtTheTop": true,
    "modalFullHeight": true,
    "fontSize": 14,
    "textColor": "#14161f",
    "hoverColor": "#292b6b",
    "chartGridColor": "#e8eaee",
    "chartTickColor": "#f0f1f4",
    "chartSuccessColor": "#079455",
    "chartColorList": ["#292b6b", "#00b6ed", "#079455", "#f79009", "#d92d20", "#7a5af8", "#ee46bc", "#656b7c", "#0b6f96"],
    "chartColorAlternativeList": ["#292b6b", "#00b6ed", "#f79009", "#079455", "#d92d20"],
    "calendarColors": {
        "": "#7a7db8a0",
        "bg": "#e2e5f7a0",
        "Call": "#d92d20",
        "Meeting": "#292b6b",
        "Task": "#079455"
    },
    "isDark": false
}
